@startuml
skinparam packageStyle folder
skinparam nodesep 20
skinparam ranksep 30
set namespaceSeparator none
hide members

package ek {
  package ek.app {
    interface CommandLine
    class Main
    class GameAssembler
  }
  package ek.ui {
    class ConsoleController
    class ConsoleView
    class ConsoleMenu
    class HandMenu
    class ConsoleOutput
    class Dashboard
    class Style
  }
  package ek.net {
    interface MessageChannel
    interface Message
    class GameServer
    class ObjectStreamChannel
    class RemoteController
    class GameClient
  }
  package ek.player {
    interface PlayerController
    interface NopeWindow
    interface TurnAction
    class BotController
    interface NopeOffer
    interface HandChange
    class GameView
  }
  package ek.rules {
    class GameConfig
    class GameSetup
    class TurnState
  }
  package ek.expansion {
    interface GameOption
    interface Expansion
    interface GameVariant
    class BaseGame
    class ExpansionRegistry
    class DeckFactory
    class PlayerRange
  }
  package ek.engine {
    interface CardEffect
    interface DrawEffect
    interface GameEventListener
    interface GameEvent
    class GameEngine
    class GameContext
    class GameState
    class PlayResolver
    class NopeResolver
    class InvalidMoveException
  }
  package ek.util {
    interface Randomizer
    interface Sleeper
    interface Waiter
    class JavaRandomizer
  }
  package ek.cards {
    class AttackEffect
    class SkipEffect
    class ShuffleEffect
    class FavorEffect
    class SeeTheFutureEffect
    class ExplodingKittenDraw
  }
  package ek.combos {
    class TwoOfAKind
    class ThreeOfAKind
  }
  package ek.model {
    interface CardType
    class Card
    class Deck
    enum BaseCardType
    class DiscardPile
    class Hand
    class Player
  }
}

' --- inheritance / implementation ---
CardEffect <|.. AttackEffect
CardEffect <|.. SkipEffect
CardEffect <|.. ShuffleEffect
CardEffect <|.. FavorEffect
CardEffect <|.. SeeTheFutureEffect
DrawEffect <|.. ExplodingKittenDraw
CardEffect <|.. TwoOfAKind
CardEffect <|.. ThreeOfAKind
GameOption <|-- Expansion
GameOption <|-- GameVariant
Expansion <|.. BaseGame
CardType <|.. BaseCardType
MessageChannel <|.. ObjectStreamChannel
PlayerController <|.. RemoteController
PlayerController <|.. BotController
PlayerController <|.. ConsoleController
GameEventListener <|.. RemoteController
GameEventListener <|.. ConsoleView
NopeWindow <|-- NopeOffer
Randomizer <|.. JavaRandomizer

